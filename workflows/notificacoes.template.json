      "parameters": {
        "jsCode": "// Pegamos o e-mail da pessoa de contato do lead\nconst email =\n  $('PIPEDRIVE1').first().json.body.email_da_pessoa_de_contato_do_lead\n    ?.toLowerCase() || \"\";\n// Lista de domínios pessoais conhecidos\nconst personalDomains = [\n  \"gmail.com\",\n  \"hotmail.com\",\n  \"outlook.com\",\n  \"live.com\",\n  \"icloud.com\",\n  \"yahoo.com\",\n  \"yahoo.com.br\",\n  \"bol.com.br\",\n  \"terra.com.br\",\n  \"uol.com.br\",\n  \"msn.com\",\n  \"aol.com\",\n  \"protonmail.com\",\n  \"zoho.com\",\n  \"ymail.com\",\n  \"gmx.com\",\n  \"me.com\"\n];\n\n// Função para extrair domínio do e-mail\nfunction getDomain(email) {\n  const parts = email.split(\"@\");\n  return parts.length > 1 ? parts[1] : \"\";\n}\n\nconst domain = getDomain(email);\n\n// Checa se domínio está na lista\nlet tipo = \"Domínio Corporativo\";\nif (personalDomains.some(d => domain.includes(d))) {\n  tipo = \"Domínio ser pessoal\";\n}\n\nreturn {\n  email,\n  dominio: domain,\n  classificacao: tipo\n};\n"
      },
